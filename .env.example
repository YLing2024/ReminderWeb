# ReminderWeb 后端环境变量示例（复制为 .env 使用；本文件不得写入任何真实值）
#
# 启动方式：node server/src/index.ts（Node ≥ 24，直接运行 TypeScript）
# 生产建议用 systemd 单服务 + nginx 反代，后端只监听回环地址。

# 监听地址。默认 127.0.0.1（仅回环）。
# AUTH_MODE=sso 时必须保持回环，否则启动失败（防止伪造 X-Auth-User 绕过网关）。
HOST=127.0.0.1

# 监听端口。
PORT=18940

# 数据目录（SQLite 数据库 reminder.db 放这里）。相对路径以启动时的工作目录为基准。
DATA_DIR=./server/data

# 认证模式：builtin（自带账号密码，开源用户默认）/ sso（网关注入 X-Auth-User）/ none（仅本机开发）。
AUTH_MODE=builtin

# builtin 用户名。
AUTH_USER=admin

# builtin 初始口令。首次启动时用它建立（scrypt 加盐哈希后入库，明文不入库、不落日志）。
# 留空且库里还没有口令时，启动会生成一次性随机口令并只在 stdout 打印一次。
AUTH_PASSWORD=changeme

# 会话有效期（天）。
SESSION_TTL_DAYS=30

# 每 IP 每 10 分钟允许的登录失败次数，超过返回 429。
LOGIN_RATE_LIMIT=5

# 是否信任 X-Forwarded-For（经 nginx 反代时用于取真实 IP 做限流）。1=是，0=否。
TRUST_PROXY=1

# 是否由后端服务前端构建产物 dist/。纯 API 部署可设为 0。
SERVE_STATIC=1

# 日志级别：debug / info / warn / error。
LOG_LEVEL=info

# NODE_ENV。设为 production 时，AUTH_MODE=none 且监听非回环地址会拒绝启动。
NODE_ENV=production

# ------------------------------------------------------------------
# 以下为 M7（WebDAV 双向同步）预留变量，M6 暂未启用，仅列出占位说明。
# ------------------------------------------------------------------
# WEBDAV_URL=https://dav.example.com/dav/
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
# WEBDAV_PATH=
