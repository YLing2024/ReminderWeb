# ReminderWeb 后端环境变量示例（复制为 .env 使用；本文件不得写入任何真实值）
#
# 启动方式：node server/src/index.ts（Node ≥ 24，直接运行 TypeScript）
# 生产建议用 systemd 单服务 + nginx 反代，后端只监听回环地址。

# 监听地址。默认 127.0.0.1（仅回环）。
# AUTH_MODE=sso 时必须保持回环，否则启动失败（防止伪造 X-Auth-User 绕过网关）。
HOST=127.0.0.1

# 监听端口。
PORT=18940

# 数据目录（SQLite 数据库 reminder.db 放这里）。相对路径以启动时的工作目录为基准。
DATA_DIR=./server/data

# 认证模式：builtin（自带账号密码，开源用户默认）/ sso（网关注入 X-Auth-User）/ none（仅本机开发）。
AUTH_MODE=builtin

# builtin 用户名。
AUTH_USER=admin

# builtin 初始口令。首次启动时用它建立（scrypt 加盐哈希后入库，明文不入库、不落日志）。
# 留空且库里还没有口令时，启动会生成一次性随机口令并只在 stdout 打印一次。
AUTH_PASSWORD=changeme

# 会话有效期（天）。
SESSION_TTL_DAYS=30

# 每 IP 每 10 分钟允许的登录失败次数，超过返回 429。
LOGIN_RATE_LIMIT=5

# 是否信任 X-Forwarded-For（经 nginx 反代时用于取真实 IP 做限流）。1=是，0=否。
TRUST_PROXY=1

# 是否由后端服务前端构建产物 dist/。纯 API 部署可设为 0。
SERVE_STATIC=1

# 跨域白名单（前后端分离部署，M10 §2）：逗号分隔的精确来源（scheme://host[:port]）。
# 留空 = 不启用 CORS；命中来源回 Access-Control-Allow-Origin + Allow-Credentials: true。
# 带 Cookie 时浏览器不允许 *，因此这里必须列精确来源。
# 例：ALLOWED_ORIGINS=https://app.example.com,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# 会话 Cookie 的 SameSite 策略：lax（默认，同源/同站）/ none（跨站前后端分离）。
# none 时仍固定 Secure，必须经 HTTPS 访问。
COOKIE_SAMESITE=lax

# 日志级别：debug / info / warn / error。
LOG_LEVEL=info

# NODE_ENV。设为 production 时，AUTH_MODE=none 且监听非回环地址会拒绝启动。
NODE_ENV=production

# ------------------------------------------------------------------
# WebDAV 双向同步（M7）。凭据只从环境变量读取，绝不返回前端、绝不写日志。
# ------------------------------------------------------------------
# 是否启用：1=启用（会定时轮询远端并双向同步），0=关闭（/api/sync/status 返回 enabled:false）。
WEBDAV_ENABLED=0

# WebDAV 目录地址（结尾斜杠会自动补齐）。启用时必填，留空会拒绝启动。
# 例：https://dav.example.com/reminder/
WEBDAV_URL=

# Basic 认证凭据（只从环境变量读取，不会返回给前端、不会写入日志）。
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# 定时轮询远端间隔（分钟，下限 1）。
WEBDAV_INTERVAL_MINUTES=10

# 本机数据变动后的延迟上传（秒，合并节流；窗口内的多次变更只上传一次）。
WEBDAV_DEBOUNCE_SECONDS=60

# 上传的备份包是否加密（1=用上游 AES-256-CBC 口径加密，与安卓端「备份数据加密」互通）。
WEBDAV_ENCRYPT=1

# 仅保留最近 N 份**由本服务上传**的备份；Android 端写入的历史备份不会被删除。
WEBDAV_KEEP=10

# 单次 HTTP 请求超时（秒）。
WEBDAV_TIMEOUT_SECONDS=20

# 客户端模式「允许转发到内网地址」的首次默认值（首次读取时落库，之后在设置页调整，重启保持）。
# 1=放开指向回环 / 内网 / 链路本地 / 云元数据的目标（仅当你的 WebDAV 装在局域网时才应开启）；
# 0=默认拒绝（SSRF 防护）。公网多人共用的部署不要设为 1。
WEBDAV_RELAY_ALLOW_PRIVATE=0

